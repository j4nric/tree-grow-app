# Vorlage für deploy/.env (deploy/setup.sh legt die Datei automatisch an).

# Hostname der API. Ohne eigene Domain: sslip.io aus der Server-IP (IPv4 mit Bindestrichen),
# z. B. 62.83.23.90 → sync.62-83-23-90.sslip.io (eigene Subdomain, weil der Name ohne
# „sync.“ oft schon von einer anderen App auf dem Server belegt ist). Alternative: name.duckdns.org.
SYNC_PUBLIC_HOST=sync.62-83-23-90.sslip.io

# Herkunft des Spiels (GitHub Pages) – nur sie darf die API aus dem Browser nutzen.
# Mehrere Werte mit Komma trennen.
ALLOWED_ORIGIN=https://j4nric.github.io

# Lokaler Port (nur 127.0.0.1) für Betriebsart B mit einem Proxy direkt auf dem Server.
SYNC_PORT=8787

# Betriebsart B mit einem Proxy im Docker-Container (z. B. Caddy einer anderen App):
# eigenes Docker-Netzwerk zwischen Proxy und vszw-sync (setup.sh legt es an; der Proxy-
# Container tritt ihm bei). NIE das interne Netzwerk der anderen App eintragen – dort wäre
# deren Datenbank erreichbar. Leer lassen, wenn der Proxy direkt auf dem Server läuft
# (dann nur 127.0.0.1:SYNC_PORT). Gesetzt:
#   docker compose -f docker-compose.yml -f docker-compose.proxy-net.yml up -d --build
PROXY_NETWORK=vszw-proxy

# So viele tägliche Sicherungen behalten (rotierend).
BACKUP_KEEP=7

# Höchstzahl an Konten (Schutz vor massenhaftem Anlegen).
MAX_ACCOUNTS=1000

# Neue Konten je IP (IPv6: je /64-Netz) und Stunde.
REGISTRATIONS_PER_IP_HOUR=3

# Weniger freier Platz (MB) auf dem Daten-Volume → keine Registrierungen und Schreibzugriffe (507).
MIN_FREE_MB=512

# Geheimes Token (mindestens 32 Zeichen) für die Sicherung außerhalb des Servers: Der
# GitHub-Workflow „Sicherung“ holt damit täglich eine Kopie über GET /api/admin/backup.
# Leer = Endpunkt aus (404). Erzeugen: openssl rand -hex 32 – derselbe Wert kommt als
# Repository-Secret SYNC_BACKUP_TOKEN nach GitHub (Anleitung: docs/KONTO.md, „Sicherungen“).
ADMIN_BACKUP_TOKEN=
