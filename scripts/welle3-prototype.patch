diff -ruN -x node_modules -x habitats.ts -x predation.ts base/tests/w3cyc.test.ts proto/tests/w3cyc.test.ts
--- base/tests/w3cyc.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ proto/tests/w3cyc.test.ts	2026-10-22 00:03:25.395685740 +0000
@@ -0,0 +1,26 @@
+import { it } from 'vitest';
+import { GROWTH, HARMONY, RANDOM, runCycles, median, formatTime } from '../scripts/simulate';
+
+const env = (globalThis as any).process.env;
+const RUNS = Number(env.W3_RUNS ?? 20);
+const LABEL = env.W3_LABEL ?? 'base';
+it('welle3 cycles', () => {
+  const out: string[] = [];
+  const t2: Record<string, number> = {};
+  for (const strat of [HARMONY, GROWTH, RANDOM]) {
+    const runs = Array.from({ length: RUNS }, (_, i) =>
+      runCycles(strat, { seed: 1000 + 7 * i, targetStage: 5, maxSeconds: 6 * 3600, care: true, cycles: 3 }),
+    );
+    const cols: string[] = [];
+    for (let c = 0; c < 3; c++) {
+      const time = median(runs.map((r) => r[c]!.result.stages[5]?.time ?? NaN).filter(Number.isFinite));
+      const gain = median(runs.map((r) => r[c]!.memoryGain));
+      const h = median(runs.map((r) => r[c]!.maxHarmony));
+      if (c === 1) t2[strat.id] = time;
+      cols.push(`${formatTime(time)} · ${h.toFixed(1)} · +${gain}`);
+    }
+    out.push(`| ${LABEL} | ${strat.name} | ${cols.join(' | ')} |`);
+  }
+  out.push(`| ${LABEL} | Wachstum ÷ Harmonie Zyklus 2 | ${(t2.harmony! / t2.growth!).toFixed(3)} |`);
+  console.log('\n' + out.join('\n'));
+}, 3_600_000);
diff -ruN -x node_modules -x habitats.ts -x predation.ts base/tests/w3run.test.ts proto/tests/w3run.test.ts
--- base/tests/w3run.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ proto/tests/w3run.test.ts	2026-10-22 00:05:45.135681617 +0000
@@ -0,0 +1,48 @@
+import { it } from 'vitest';
+import { GROWTH, HARMONY, RANDOM, monteCarlo, stageStats, formatTime, median, mean } from '../scripts/simulate';
+import { SPECIES_BY_ID } from '../src/content/species';
+
+const env = (globalThis as any).process.env;
+const RUNS = Number(env.W3_RUNS ?? 40);
+const LABEL = env.W3_LABEL ?? 'base';
+const TARGET = Number(env.W3_TARGET ?? 7);
+it('welle3', () => {
+  const lines: string[] = [];
+  const extra: string[] = [];
+  for (const strat of [HARMONY, GROWTH, RANDOM]) {
+    (globalThis as any).__w3ev = {};
+    const [s] = monteCarlo([strat], RUNS, { targetStage: TARGET, maxSeconds: 6 * 3600, care: true });
+    const st = [3, 4, 5, 6, 7].map((k) => formatTime(stageStats(s!, k).time));
+    const h = stageStats(s!, 5);
+    const w = stageStats(s!, 6);
+    const arrive = s!.runs.map((r) => r.memoryPath.find((p) => p.waypoint >= 20)?.after ?? NaN).filter(Number.isFinite);
+    const endMem = s!.runs.map((r) => r.memoryPath.at(-1)?.after ?? NaN).filter(Number.isFinite);
+    const isNew = (id: string) => (SPECIES_BY_ID.get(id) as any)?.w3 === true;
+    const newAtHain = mean(s!.runs.map((r) => (r.stages[5]?.animalIds ?? []).filter(isNew).length));
+    const newAtEnd = mean(s!.runs.map((r) => r.final.animalIds.filter(isNew).length));
+    lines.push(
+      `| ${LABEL} | ${s!.strategy.name} | ${st.join(' | ')} | ${h.harmony.toFixed(1)} | ${w.harmony.toFixed(1)} | ${h.animals.toFixed(1)} | ${(100 * h.happiness).toFixed(1)} % | ${median(arrive).toFixed(0)} | ${median(endMem).toFixed(0)} | ${newAtHain.toFixed(1)} / ${newAtEnd.toFixed(1)} | ${formatTime(h.gapMax)} |`,
+    );
+    const rank = (stage: number, id: string) => mean(s!.runs.map((r) => (stage < 0 ? r.final : r.stages[stage])?.careRanks[id] ?? 0));
+    const fin = s!.runs.map((r) => r.final);
+    const comm = (id: string) => (fin.filter((f) => f.communities.includes(id)).length / fin.length).toFixed(2);
+    const reptiles = mean(fin.map((f) => f.genus['reptiles' as never] ?? 0));
+    const per = (id: string) => (fin.filter((f) => f.animalIds.includes(id)).length / fin.length).toFixed(2);
+    const ev = (globalThis as any).__w3ev as Record<string, number>;
+    const sum: Record<string, number> = {};
+    for (const [k, v] of Object.entries(ev)) {
+      const id = k.split('@')[0]!;
+      sum[id] = (sum[id] ?? 0) + v;
+    }
+    const evs = Object.entries(sum)
+      .filter(([k]) => /(caterpillar|vole|beetle|slug)-year|windthrow|storm|toad-migration/.test(k))
+      .map(([k, v]) => `${k}:${(v / RUNS).toFixed(2)}`)
+      .join(' ') + ` | alle Ereignisse: ${(Object.values(sum).reduce((a, b) => a + b, 0) / RUNS).toFixed(2)}`;
+    extra.push(
+      `${s!.strategy.id}: care AB meadow ${rank(4, 'meadow').toFixed(2)} nest ${rank(4, 'nest-boxes').toFixed(2)} wild ${rank(4, 'wildflower-hem').toFixed(2)} Hain meadow ${rank(5, 'meadow').toFixed(2)} pile ${rank(5, 'deadwood-pile').toFixed(2)} | end meadow ${rank(-1, 'meadow').toFixed(2)} pile ${rank(-1, 'deadwood-pile').toFixed(2)} wall ${rank(-1, 'drystone-wall').toFixed(2)} pond ${rank(-1, 'pond').toFixed(2)} | comm end meadow-song ${comm('meadow-song')} brushpile ${comm('brushpile')} sun-wall ${comm('sun-wall')} snake-pond ${comm('snake-pond')} | reptiles ${reptiles.toFixed(2)} | ` +
+        ['cricket', 'fieldmouse', 'rabbit', 'lizard', 'kestrel', 'wren', 'rosechafer', 'turkeytail', 'slowworm', 'weasel', 'sandlizard', 'masonbee', 'grasssnake', 'smoothsnake'].map((id) => `${id} ${per(id)}`).join(' ') +
+        `\n   events: ${evs}`,
+    );
+  }
+  console.log('\n' + lines.join('\n') + '\n' + extra.join('\n'));
+}, 3_600_000);
